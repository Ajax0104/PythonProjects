# Slicing and Formatting Practice

inventory = [
    "FAN-6001-BATH",
    "FAN-6002-BATH",
    "PUMP-301-HYDRONIC",
    "VALVE-102-COPPER",
    "FAN-6003-BATH",
    "EXHAUST-8902-VENT"
]

print("--- Inventory Summary ---")

# Extract category codes (first 3 Letter) using slicing

for item in inventory:
   
   # .split("-") breaks "VALVE-102-COPPER" into a list: ['VALUE'], '102', 'COPPER']
   
   parts = item.split("-")

   category = parts[0]        # Slice first 3 Characters
   item_id = parts[1]         # Slice middle ID number
   sub_cat = parts[2]         # Extra detail field 
    # f-string alignment (:10 pads spaces so columns line up visually)
   print(f"CATEGORY: {category:<8} | ID: {item_id:<5} | SUB-CATEGORY: {sub_cat:<9} | Full Code: {item}")

# Quick Slice challenge: Grab only the last 3 items in the list

recent_items = inventory[-3:]
print(f"\nLast 3 iitems added: {recent_items}")